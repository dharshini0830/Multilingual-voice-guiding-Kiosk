rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Phase 3: Hardened Global Helpers
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'dharshini20060830@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSupportedLanguage(lang) {
      return lang is string && lang in ['en', 'ta', 'hi', 'te', 'kn', 'ml', 'bn', 'mr', 'gu', 'pa', 'or', 'ur'];
    }

    function isSupportedServiceType(svc) {
      return svc is string && svc in ['citizen_certificate', 'pension_welfare', 'ration_card', 'bank_kyc'];
    }

    function hasUserParent(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) ||
        existsAfter(/databases/$(database)/documents/users/$(userId));
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (Synchronized with firebase-blueprint.json)
    // -------------------------------------------------------------------------
    function isValidUserProfile(data, expectedUid) {
      return data.keys().hasAll(['uid', 'displayName', 'preferredLanguage', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'preferredLanguage', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == expectedUid
        && data.displayName is string
        && data.displayName.size() <= 120
        && isSupportedLanguage(data.preferredLanguage)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateAccount(data, expectedUid) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == expectedUid
        && data.email is string
        && data.email.size() <= 254
        && data.updatedAt is timestamp;
    }

    function isValidFormDraft(data, expectedUid) {
      return data.keys().hasAll([
          'ownerId', 'language', 'serviceType', 'fullName', 'idNumber', 'dob',
          'gender', 'fatherName', 'phoneNumber', 'address', 'pincode',
          'consentGiven', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'language', 'serviceType', 'fullName', 'idNumber', 'dob',
          'gender', 'fatherName', 'phoneNumber', 'address', 'pincode',
          'consentGiven', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == expectedUid
        && isSupportedLanguage(data.language)
        && isSupportedServiceType(data.serviceType)
        && data.fullName is string && data.fullName.size() <= 100
        && data.idNumber is string && data.idNumber.size() <= 12 && data.idNumber.matches('^[0-9]{0,12}$')
        && data.dob is string && data.dob.size() <= 24
        && data.gender is string && data.gender in ['', 'Male', 'Female', 'Other']
        && data.fatherName is string && data.fatherName.size() <= 100
        && data.phoneNumber is string && data.phoneNumber.size() <= 10 && data.phoneNumber.matches('^[0-9]{0,10}$')
        && data.address is string && data.address.size() <= 240
        && data.pincode is string && data.pincode.size() <= 6 && data.pincode.matches('^[0-9]{0,6}$')
        && data.consentGiven is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidApplicationSubmission(data, expectedUid) {
      return data.keys().hasAll([
          'ownerId', 'referenceId', 'submittedAt', 'language', 'maskedIdNumber',
          'status', 'consentTimestamp', 'serviceType', 'fullName', 'dob',
          'gender', 'fatherName', 'phoneNumber', 'address', 'pincode', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'referenceId', 'submittedAt', 'language', 'maskedIdNumber',
          'status', 'consentTimestamp', 'serviceType', 'fullName', 'dob',
          'gender', 'fatherName', 'phoneNumber', 'address', 'pincode', 'createdAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == expectedUid
        && data.referenceId is string && data.referenceId.size() >= 4 && data.referenceId.size() <= 40 && data.referenceId.matches('^[A-Z0-9\\-]+$')
        && data.submittedAt is string && data.submittedAt.size() >= 8 && data.submittedAt.size() <= 40
        && isSupportedLanguage(data.language)
        && data.maskedIdNumber is string && data.maskedIdNumber.size() >= 4 && data.maskedIdNumber.size() <= 24
        && data.status is string && data.status == 'submitted'
        && data.consentTimestamp is string && data.consentTimestamp.size() >= 8 && data.consentTimestamp.size() <= 40
        && isSupportedServiceType(data.serviceType)
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
        && data.dob is string && data.dob.size() >= 8 && data.dob.size() <= 24
        && data.gender is string && data.gender in ['Male', 'Female', 'Other']
        && data.fatherName is string && data.fatherName.size() >= 2 && data.fatherName.size() <= 100
        && data.phoneNumber is string && data.phoneNumber.size() == 10 && data.phoneNumber.matches('^[6-9][0-9]{9}$')
        && data.address is string && data.address.size() >= 5 && data.address.size() <= 240
        && data.pincode is string && data.pincode.size() == 6 && data.pincode.matches('^[1-9][0-9]{5}$')
        && data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Admin Lookup Documents (Read-only self check; never client writable)
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Users Root Profile (Non-PII preferences; owner-only)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && (isOwner(userId) || isAdmin())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredLanguage', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(userId);

      // Isolated PII Subcollection (/users/{userId}/private/account)
      match /private/{docId} {
        allow get: if isVerifiedUser() && isValidId(userId) && isValidId(docId) && docId == 'account' && (isOwner(userId) || isAdmin());
        allow list: if false;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'account'
          && isValidUserPrivateAccount(incoming(), userId)
          && incoming().updatedAt == request.time
          && hasUserParent(userId);

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'account'
          && isValidUserPrivateAccount(incoming(), userId)
          && (isOwner(userId) || isAdmin())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);

        allow delete: if isAdmin() && isValidId(userId) && isValidId(docId);
      }

      // Active Form Drafts Subcollection (/users/{userId}/drafts/{draftId})
      match /drafts/{draftId} {
        allow get: if isVerifiedUser() && isValidId(userId) && isValidId(draftId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && isValidId(userId) && (
          resource.data.ownerId == request.auth.uid || isAdmin()
        );

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(draftId)
          && isValidFormDraft(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserParent(userId);

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(draftId)
          && isValidFormDraft(incoming(), userId)
          && (isOwner(userId) || isAdmin())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'language', 'serviceType', 'fullName', 'idNumber', 'dob',
            'gender', 'fatherName', 'phoneNumber', 'address', 'pincode',
            'consentGiven', 'updatedAt'
          ]);

        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(draftId) && (isOwner(userId) || isAdmin());
      }

      // Immutable Submitted Applications Subcollection (/users/{userId}/submissions/{submissionId})
      match /submissions/{submissionId} {
        allow get: if isVerifiedUser() && isValidId(userId) && isValidId(submissionId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && isValidId(userId) && (
          resource.data.ownerId == request.auth.uid || isAdmin()
        );

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(submissionId)
          && isValidApplicationSubmission(incoming(), userId)
          && incoming().createdAt == request.time
          && hasUserParent(userId);

        // Pillar 4.6: Terminal State Locking — once submitted, receipts are immutable unless admin correction
        allow update: if isAdmin()
          && isValidId(userId)
          && isValidId(submissionId)
          && isValidApplicationSubmission(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().referenceId == existing().referenceId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'fullName', 'dob', 'gender', 'fatherName',
            'phoneNumber', 'address', 'pincode', 'maskedIdNumber'
          ]);

        allow delete: if isAdmin() && isValidId(userId) && isValidId(submissionId);
      }
    }
  }
}
