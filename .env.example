# GEMINI_API_KEY: Required for optional server-side AI OCR enhancement, multilingual neural TTS fallback, and audio transcription.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ENCRYPTION_MASTER_KEY: Optional custom 32+ char key for AES-256-GCM encryption of saved form PII at rest.
# If omitted, a cryptographically random runtime key is generated in memory.
ENCRYPTION_MASTER_KEY=""

# SESSION_SECRET: Optional secret for signing ephemeral kiosk Bearer session tokens.
SESSION_SECRET=""
